# 看起来很忙 Agent · 服务端（版本 B）环境变量。复制为 .env（chmod 600），不要进 git。
# 所有变量以 LBA_ 开头。密钥类只放这里或 docker secret，永不进日志/聊天/仓库。

# --- 飞书企业自建应用（同 Part A 的应用，加「机器人」能力）---
LBA_LARK_APP_ID=cli_xxxxxxxxxxxx
LBA_LARK_APP_SECRET=
# OAuth 回调与邮箱表单的公网 HTTPS 根地址（无备案域名走 :8443，见 README）
LBA_PUBLIC_BASE_URL=https://report.example.com:8443

# --- 服务 ---
LBA_HTTP_PORT=8080
LBA_DB_PATH=/data/lba.sqlite3
# 主密钥：二选一。生成：python -m lba gen-key
LBA_MASTER_KEY_FILE=/run/secrets/lba_master_key
#LBA_MASTER_KEY=
# 轮换时把旧 key 放这里，跑 python -m lba rotate-key 后删掉
#LBA_MASTER_KEY_PREVIOUS=

# --- LLM（生产：百炼按量付费，标准商用条款）---
LBA_LLM_FORMAT=openai
LBA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LBA_LLM_MODEL=qwen-plus
LBA_LLM_API_KEY=
LBA_LLM_AUTH=bearer
LBA_LLM_MAX_TOKENS=1500
# 开发期可临时用 Token Plan（Anthropic 格式）；条款限 AI 编程用途，doctor 会标红：
#LBA_LLM_FORMAT=anthropic
#LBA_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic
#LBA_LLM_MODEL=qwen3.7-max

# --- 调度与保留 ---
LBA_DEFAULT_TZ=Asia/Shanghai
LBA_DEFAULT_RUN_TIME=21:00
LBA_CATCHUP_WINDOW_MIN=180
LBA_SKIP_WEEKENDS=1
#LBA_HOLIDAYS_FILE=/data/holidays.txt
LBA_REPORT_RETENTION_DAYS=14
# 实测 refresh_token 有效期 7 天：每天预刷新一次，不能按周
LBA_KEEPALIVE_DAYS=1
#LBA_DENYLIST_FILE=/data/denylist.txt
# 管理员 open_id，逗号分隔；收 230013 等运维通知
LBA_ADMIN_OPEN_IDS=
LBA_LOG_LEVEL=INFO
# 镜像内为 /app/skills/looks-busy-agent；本地开发指向仓库路径
LBA_SKILL_DIR=/app/skills/looks-busy-agent
